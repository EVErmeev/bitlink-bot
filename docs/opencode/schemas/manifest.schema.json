{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenCode Manifest",
  "description": "Схема manifest.json — точки входа служебного контура OpenCode.",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "default_branch",
    "base_commit",
    "working_branch",
    "status",
    "validation_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Версия схемы manifest.",
      "enum": ["1.0"]
    },
    "repository": {
      "type": "string",
      "description": "Полное имя репозитория (owner/repo)."
    },
    "default_branch": {
      "type": "string",
      "description": "Ветка по умолчанию."
    },
    "audit_id": {
      "type": "string",
      "description": "Идентификатор текущего аудита."
    },
    "audit_file": {
      "type": "string",
      "description": "Относительный путь к файлу аудита."
    },
    "active_task_id": {
      "type": "string",
      "description": "Идентификатор активного задания."
    },
    "active_task_file": {
      "type": "string",
      "description": "Относительный путь к файлу задания."
    },
    "base_commit": {
      "type": "string",
      "description": "SHA коммита, на котором проводился аудит."
    },
    "head_commit": {
      "type": ["string", "null"],
      "description": "SHA последнего коммита с исправлениями."
    },
    "working_branch": {
      "type": "string",
      "description": "Имя рабочей ветки с исправлениями."
    },
    "pull_request_url": {
      "type": ["string", "null"],
      "description": "URL Pull Request."
    },
    "status": {
      "type": "string",
      "description": "Текущий статус цикла.",
      "enum": [
        "changes_required",
        "in_progress",
        "awaiting_independent_validation",
        "accepted",
        "conditionally_accepted",
        "rejected"
      ]
    },
    "validation_state": {
      "type": "string",
      "description": "Состояние валидации.",
      "enum": [
        "awaiting_fixes",
        "implementing_fixes",
        "awaiting_review",
        "validation_in_progress",
        "validation_failed",
        "accepted",
        "conditionally_accepted"
      ]
    },
    "required_checks": {
      "type": "array",
      "description": "Список обязательных проверок перед PR.",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "description": "Список замечаний с текущим статусом.",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Идентификатор замечания (BB-CRIT-XXX или BB-MAJ-XXX)."
          },
          "status": {
            "type": "string",
            "description": "Статус исправления.",
            "enum": ["OPEN", "IN_PROGRESS", "FIXED", "PARTIALLY_FIXED", "NOT_FIXED", "NOT_VERIFIABLE", "REGRESSION"]
          },
          "fix_commit": {
            "type": ["string", "null"],
            "description": "SHA коммита с исправлением."
          },
          "changed_files": {
            "type": "array",
            "description": "Файлы, изменённые для исправления.",
            "items": {"type": "string"}
          },
          "tests": {
            "type": "array",
            "description": "Тесты, добавленные или изменённые.",
            "items": {"type": "string"}
          },
          "executor_comment": {
            "type": "string",
            "description": "Комментарий исполнителя."
          }
        }
      }
    },
    "test_results": {
      "type": "object",
      "description": "Результаты автоматических проверок.",
      "properties": {
        "compileall": {"type": ["object", "string", "null"]},
        "pytest": {"type": ["object", "string", "null"]},
        "ruff": {"type": ["object", "string", "null"]},
        "mypy": {"type": ["object", "string", "null"]}
      }
    },
    "changed_files": {
      "type": "array",
      "description": "Все изменённые файлы в текущем цикле.",
      "items": {"type": "string"}
    },
    "remaining_blockers": {
      "type": "array",
      "description": "Оставшиеся блокирующие замечания.",
      "items": {"type": "string"}
    },
    "next_action": {
      "type": "string",
      "description": "Следующее действие."
    },
    "updated_at": {
      "type": "string",
      "description": "Дата и время последнего обновления (ISO 8601)."
    }
  }
}